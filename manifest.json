{
  "manifest_version": 3,
  "name": "Site Request",
  "version": "1.3.0",
  "key": "",
  "description": "Request access to a blocked site by email, in one click.",
  "permissions": [
    "tabs",
    "storage",
    "webNavigation",
    "alarms",
    "downloads",
    "notifications",
    "webRequest",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "bg.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Site Request",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "content/gmail.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://filter.techloq.com/*"
      ],
      "js": [
        "content/blockpage.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
